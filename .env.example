MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=http://localhost:9000

AIRBYTE_CLIENT_ID=4fba4cb3-9f68-4bd4-980f-cafb7de62553
AIRBYTE_CLIENT_SECRET=7645097f-c3f3-423a-820a-132351b14072
AIRBYTE_ADMIN_PASSWORD=AirbyteAdmin@123
AIRBYTE_PORT=8080

# Endereço da API pública do Airbyte, usado pelos DAGs para disparar sync e acompanhar job.
# NÃO pode ser localhost: de dentro do container do Airflow, `localhost` é o próprio
# container e `host.docker.internal` não resolve (o compose não tem extra_hosts, e o
# Airbyte vive no kind do abctl, publicado no host). Use o IP do host — que também
# funciona para quem roda a CLI na própria máquina.
AIRBYTE_API_URL=http://192.168.10.80:8080

# Airbyte is served over plain HTTP (VPN, no TLS). Session cookies must NOT be marked
# Secure, or the browser silently drops them and login fails with correct credentials.
# Presence-based: any non-empty value passes --insecure-cookies. Empty = omit the flag,
# which is only correct if you put TLS in front of Airbyte.
AIRBYTE_INSECURE_COOKIES=true

# Ingress hostname. Empty = wildcard ingress, accepts any host — required to reach
# Airbyte by IP over the VPN. Setting it makes the ingress answer ONLY that name,
# and access by IP starts returning 404.
AIRBYTE_HOST=

AIRFLOW_PORT=8081
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_FERNET_KEY=loeY4PiYr9VPykEaKUPAj-u0-ZwiW2Li7Cf87k9AkUw=

ETL_STRICT=false

CATALOG_API_PORT=8002
CATALOG_SPARK_MASTER=local[2]
